# Local CRM backend (this machine's LAN IP). Used by `npm run dev`.
VITE_API_BASE_URL=http://192.168.29.89:5001/api
# Microsoft Clarity project ID (Clarity → Settings → Overview). Empty = analytics off.
VITE_CLARITY_ID=
# Visitor counter is OFF in dev (it would count our own testing in the live CRM). Set true to test it.
VITE_TRACK_VISITS=false
