# Public CRM API. Used by `npm run build`.
VITE_API_BASE_URL=https://api.teamnmakeovers.com/api
# Microsoft Clarity project ID (Clarity → Settings → Overview). Empty = analytics off.
VITE_CLARITY_ID=
# Visitor counter (CRM → Team N Website → Overview). On unless set to false.
VITE_TRACK_VISITS=true
